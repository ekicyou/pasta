local PASTA = require "pasta"
local GLOBAL = require "pasta.global"

do
    local SCENE = PASTA.create_scene("挨拶")

    function SCENE.__start__(act, ...)
        local args = { ... }
        local save, var = act:init_scene(SCENE, "挨拶", nil, "test.pasta|7:3,11:3,12:3")

        act:line()
        act:actor_proxy("さくら"):talk("「おはようございます」")
    end
end

do
    local SCENE = PASTA.create_scene("挨拶")

    function SCENE.__start__(act, ...)
        local args = { ... }
        local save, var = act:init_scene(SCENE, "挨拶", nil, "test.pasta|19:6,23:6,24:6")

        act:line()
        act:actor_proxy("さくら"):talk("「こんにちは」")
    end
end

do
