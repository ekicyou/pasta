local PASTA = require "pasta"
local GLOBAL = require "pasta.global"

do
    local SCENE = PASTA.create_scene("メイン")

    function SCENE.__start__(act, ...)
        local args = { ... }
        local save, var = act:init_scene(SCENE)

        var.x = "挨拶"
        act:actor_proxy("さくら"):talk(act:actor_proxy("さくら"):word(var.x, "var.x"))
        act:actor_proxy("さくら"):talk("です")
        act:actor_proxy("うにゅう"):talk(act:actor_proxy("うにゅう"):word(save.k, "save.k"))
        act:actor_proxy("うにゅう"):talk((act:actor_proxy("うにゅう"):expr_fn_var(args[1], "args[1]", 1, var.a)))
        var.y = act:word(save.k, "save.k")
        save.y = act:word(var.x, "var.x")
        act:word(var.x, "var.x")
        act:set_property("prop", act:word(var.x, "var.x"))
        var.z = act:expr_fn_var(var.f, "var.f") + 1
    end
end
