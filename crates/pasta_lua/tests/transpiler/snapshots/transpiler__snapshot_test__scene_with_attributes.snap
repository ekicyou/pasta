---
local PASTA = require "pasta"
local GLOBAL = require "pasta.global"

do
    local SCENE = PASTA.create_scene("メイン"); PASTA.set_scene_attrs(SCENE, "__start__", { { key = "天気", value = "晴れ" }, { key = "場所", value = "東京" }, { key = "時間帯", value = "朝" } })

    function SCENE.__start__(act, ...)
        local args = { ... }
        local save, var = act:init_scene(SCENE, "メイン", nil, "test.pasta|7:7,11:7,12:7")

        act:line()
        act:actor_proxy("さくら"):talk("「今日の天気は晴れです」")
    end
end
