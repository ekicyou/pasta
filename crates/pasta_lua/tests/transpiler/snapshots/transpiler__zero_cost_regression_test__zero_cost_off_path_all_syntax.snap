expression: lua_code
---
local PASTA = require "pasta"
local GLOBAL = require "pasta.global"

PASTA.create_word("挨拶"):entry("おはよう", "こんにちは", "こんばんは")
do
    local ACTOR = PASTA.create_actor("さくら")
    ACTOR:create_word("一人称"):entry("私", "わたし", "あたし")

    function ACTOR.時刻(act)
        return "朝"
    end
end

do
    local ACTOR = PASTA.create_actor("うにゅう")
    ACTOR:create_word("一人称"):entry("僕", "ぼく")
end

do
    local SCENE = PASTA.create_scene("メイン")

    SCENE:create_word("場所"):entry("東京", "大阪")

    function SCENE.__start__(act, ...)
        local args = { ... }
        local save, var = act:init_scene(SCENE, "メイン", nil, "test.pasta|24:23,28:23,29:24,30:25,31:26,32:26,33:26,34:26,35:26,36:27,37:27,38:27,39:28,53:33,54:34")

        var.カウンタ = "10"
        save.グローバル = "永続値"
        act:set_property("mood", "happy")
        act:actor_proxy("さくら"):talk("「")
        act:actor_proxy("さくら"):talk(act:actor_proxy("さくら"):word("挨拶"))
        act:actor_proxy("さくら"):talk("！")
        act:actor_proxy("さくら"):talk(act:actor_proxy("さくら"):word("一人称は元気です"))
        act:actor_proxy("さくら"):talk("」")
        act:actor_proxy("うにゅう"):talk("「")
        act:actor_proxy("うにゅう"):talk(act:actor_proxy("うにゅう"):word("場所にいるよ"))
        act:actor_proxy("うにゅう"):talk("」")
        return act:call(SCENE.__global_name__, "サブ会話", {}, table.unpack(args))
    end

    function SCENE.サブ会話_1(act, ...)
        local args = { ... }
        local save, var = act:init_scene(SCENE, "メイン", "サブ会話", "test.pasta|42:30,46:31,47:31,48:31,49:31,50:31,53:33,54:34")

        act:actor_proxy("さくら"):talk("「カウンタは")
        act:actor_proxy("さくら"):talk(var.カウンタ, "var.カウンタ")
        act:actor_proxy("さくら"):talk("、グローバルは")
        act:actor_proxy("さくら"):talk(save.グローバル, "save.グローバル")
        act:actor_proxy("さくら"):talk("」")
    end

    local total = 1 + 2
    return total
end
