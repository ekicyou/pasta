{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Pasta DSL",
    "scopeName": "source.pasta",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#lua-code-block"
        },
        {
            "include": "#global-scene"
        },
        {
            "include": "#local-scene"
        },
        {
            "include": "#attribute"
        },
        {
            "include": "#choice"
        },
        {
            "include": "#word"
        },
        {
            "include": "#variable"
        },
        {
            "include": "#call"
        },
        {
            "include": "#cue-command"
        },
        {
            "include": "#actor"
        },
        {
            "include": "#action-line"
        }
    ],
    "repository": {
        "comment": {
            "match": "^[\\s\u3000]*[\uff03#].*$",
            "name": "comment.line.pasta"
        },
        "line-end-comment": {
            "match": "[＃#].*$",
            "name": "comment.line.pasta"
        },
        "decl-attr": {
            "match": "([＆&])([\\p{XID_Start}_]\\p{XID_Continue}*[\\s　]*[：:][\\s　]*(?:「{4}(?:(?!」{4}).)+」{4}|「{3}(?:(?!」{3}).)+」{3}|「{2}(?:(?!」{2}).)+」{2}|「[^」]*」|(\"++)(?:(?!\\3).)+\\3|\"\"|[^\\s　：:＆&＃#]+))",
            "captures": {
                "1": {
                    "name": "keyword.other.marker.pasta"
                },
                "2": {
                    "name": "entity.other.attribute-name.pasta"
                }
            },
            "name": "meta.attribute.pasta"
        },
        "decl-rest": {
            "patterns": [
                {
                    "include": "#decl-attr"
                },
                {
                    "include": "#line-end-comment"
                }
            ]
        },
        "global-scene": {
            "match": "^([＊*])([\\p{XID_Start}_]\\p{XID_Continue}*)?(.*)$",
            "captures": {
                "1": {
                    "name": "keyword.other.marker.pasta"
                },
                "2": {
                    "name": "keyword.control.scene.pasta"
                },
                "3": {
                    "patterns": [
                        {
                            "include": "#decl-rest"
                        }
                    ]
                }
            },
            "name": "meta.scene.global.pasta"
        },
        "local-scene": {
            "match": "^(\\s*)([・\\-])([\\p{XID_Start}_]\\p{XID_Continue}*)?(.*)$",
            "captures": {
                "2": {
                    "name": "keyword.other.marker.pasta"
                },
                "3": {
                    "name": "keyword.control.scene.pasta"
                },
                "4": {
                    "patterns": [
                        {
                            "include": "#decl-rest"
                        }
                    ]
                }
            },
            "name": "meta.scene.local.pasta"
        },
        "attribute": {
            "match": "^(\\s*)([＆&].*)$",
            "captures": {
                "2": {
                    "patterns": [
                        {
                            "include": "#decl-rest"
                        }
                    ]
                }
            }
        },
        "choice": {
            "match": "^(\\s*)([＠@][？?])([\\p{XID_Start}_]\\p{XID_Continue}*)?(「[^」]*」)?[\\s　]*([＃#].*)?",
            "captures": {
                "2": {
                    "name": "keyword.other.marker.pasta"
                },
                "3": {
                    "name": "keyword.control.pasta"
                },
                "4": {
                    "name": "string.quoted.other.pasta"
                },
                "5": {
                    "name": "comment.line.pasta"
                }
            },
            "name": "meta.choice.pasta"
        },
        "word": {
            "match": "^(\\s*)([＠@])(?![？?])([^：:]*[：:](?:[\\s　]*+(?>「{4}(?:(?!」{4}).)+」{4}|「{3}(?!「)(?:(?!」{3}).)+」{3}|「{2}(?!「)(?:(?!」{2}).)+」{2}|「(?!「)[^」]*」|(\"++)(?:(?!\\4).)+\\4|\"\"|\\\\_\\?.*?\\\\_\\?|\\\\_!.*?\\\\_!|\\\\(?:[spb][0-9]|w[1-9]|_{0,2}[0-9A-Za-z!+*?&-](?:\\[(?:\"(?:[^\"]|\"\")*\")?(?:(?:\\\\.|[^\\]\\\\,\"])(?:\\\\.|[^\\]\\\\,])*)?(?:,(?:\"(?:[^\"]|\"\")*\")?(?:(?:\\\\.|[^\\]\\\\,\"])(?:\\\\.|[^\\]\\\\,])*)?)*\\])?)|(?![「\"])(?:(?![\\s　]*[、，,]).)+)[\\s　]*+[、，,])*+[\\s　]*+(?>「{4}(?:(?!」{4}).)+」{4}|「{3}(?!「)(?:(?!」{3}).)+」{3}|「{2}(?!「)(?:(?!」{2}).)+」{2}|「(?!「)[^」]*」|(\"++)(?:(?!\\5).)+\\5|\"\"|\\\\_\\?.*?\\\\_\\?|\\\\_!.*?\\\\_!|\\\\(?:[spb][0-9]|w[1-9]|_{0,2}[0-9A-Za-z!+*?&-](?:\\[(?:\"(?:[^\"]|\"\")*\")?(?:(?:\\\\.|[^\\]\\\\,\"])(?:\\\\.|[^\\]\\\\,])*)?(?:,(?:\"(?:[^\"]|\"\")*\")?(?:(?:\\\\.|[^\\]\\\\,\"])(?:\\\\.|[^\\]\\\\,])*)?)*\\])?)|(?![「\"])(?:(?![\\s　]*[、，,]).)+)?+|.+)[\\s　]*([＃#].*)?$",
            "captures": {
                "2": {
                    "name": "keyword.other.marker.pasta"
                },
                "3": {
                    "name": "markup.inline.raw.string.pasta"
                },
                "6": {
                    "name": "comment.line.pasta"
                }
            },
            "name": "meta.word.pasta"
        },
        "variable": {
            "match": "^(\\s*)([＄$])((?:「{4}(?:(?!」{4}).)+」{4}|「{3}(?:(?!」{3}).)+」{3}|「{2}(?:(?!」{2}).)+」{2}|「[^」]*」|(\"++)(?:(?!\\4).)+\\4|\"\"|[^＃#])*?)[\\s　]*([＃#].*)?$",
            "captures": {
                "2": {
                    "name": "keyword.other.marker.pasta"
                },
                "3": {
                    "name": "variable.other.pasta"
                },
                "5": {
                    "name": "comment.line.pasta"
                }
            },
            "name": "meta.variable.pasta"
        },
        "call": {
            "match": "^(\\s*)([＞>])((?:「{4}(?:(?!」{4}).)+」{4}|「{3}(?:(?!」{3}).)+」{3}|「{2}(?:(?!」{2}).)+」{2}|「[^」]*」|(\"++)(?:(?!\\4).)+\\4|\"\"|[^＃#])*?)[\\s　]*([＃#].*)?$",
            "captures": {
                "2": {
                    "name": "keyword.other.marker.pasta"
                },
                "3": {
                    "name": "keyword.control.pasta"
                },
                "5": {
                    "name": "comment.line.pasta"
                }
            },
            "name": "meta.call.pasta"
        },
        "actor": {
            "match": "^(\\s*)([％%])([^＃#]*?)[\\s　]*([＃#].*)?$",
            "captures": {
                "2": {
                    "name": "keyword.other.marker.pasta"
                },
                "3": {
                    "name": "entity.name.class.pasta"
                },
                "4": {
                    "name": "comment.line.pasta"
                }
            },
            "name": "meta.actor.pasta"
        },
        "lua-code-block": {
            "begin": "^(\\s*)(```)(lua)?\\s*$",
            "end": "^(\\s*)(```)\\s*$",
            "beginCaptures": {
                "2": {
                    "name": "punctuation.definition.code.begin.pasta"
                },
                "3": {
                    "name": "entity.name.type.language.pasta"
                }
            },
            "endCaptures": {
                "2": {
                    "name": "punctuation.definition.code.end.pasta"
                }
            },
            "name": "meta.embedded.block.lua",
            "contentName": "meta.embedded.block.lua.content"
        },
        "action-line": {
            "match": "^(\\s+)(\\S+?)\\s*([：:])(.*)$",
            "captures": {
                "2": {
                    "name": "entity.name.type.actor.pasta"
                },
                "3": {
                    "name": "punctuation.separator.pasta"
                },
                "4": {
                    "patterns": [
                        {
                            "include": "#inline-dynamic-ref"
                        },
                        {
                            "include": "#inline-word-ref"
                        },
                        {
                            "include": "#inline-var-ref"
                        },
                        {
                            "include": "#inline-fn-call"
                        },
                        {
                            "include": "#inline-sakura-script"
                        },
                        {
                            "include": "#inline-escape"
                        },
                        {
                            "include": "#inline-talk"
                        }
                    ]
                }
            }
        },
        "inline-dynamic-ref": {
            "match": "(?<![＠@])(?:[＠@]{2})*([＠@][＄$][＊*]?[^＠@＄$\\\\\\s]+)",
            "captures": {
                "1": {
                    "name": "markup.inline.raw.string.pasta"
                }
            }
        },
        "inline-word-ref": {
            "match": "[＠@]([^＠@＄$\\\\\\s]+)",
            "name": "markup.inline.raw.string.pasta"
        },
        "inline-var-ref": {
            "match": "[＄$][＊*]?([^＠@＄$\\\\\\s]+)",
            "name": "variable.other.reference.pasta"
        },
        "inline-fn-call": {
            "match": "[＠@](\\w+)\\([^)]*\\)",
            "name": "entity.name.function.call.pasta"
        },
        "inline-sakura-script": {
            "match": "\\\\_\\?.*?\\\\_\\?|\\\\_!.*?\\\\_!|\\\\(?:[spb][0-9]|w[1-9]|_{0,2}[0-9A-Za-z!+*?&-](?:\\[(?:\"(?:[^\"]|\"\")*\")?(?:(?:\\\\.|[^\\]\\\\,\"])(?:\\\\.|[^\\]\\\\,])*)?(?:,(?:\"(?:[^\"]|\"\")*\")?(?:(?:\\\\.|[^\\]\\\\,\"])(?:\\\\.|[^\\]\\\\,])*)?)*\\])?)",
            "name": "string.other.sakura-script.pasta"
        },
        "inline-escape": {
            "match": "\\\\[\\\\%＠@＄$＞>]",
            "name": "constant.character.escape.pasta"
        },
        "inline-talk": {
            "match": "[^＠@＄$\\\\]+",
            "name": "meta.talk.pasta"
        },
        "cue-command": {
            "match": "^([\\s　]*)([!！])([\\p{XID_Start}_]\\p{XID_Continue}*)(?:([＠@])([^(（\\s　]+))?(?:([（(])((?:(?>「{4}(?:(?!」{4}).)+」{4}|「{3}(?!「)(?:(?!」{3}).)+」{3}|「{2}(?!「)(?:(?!」{2}).)+」{2}|「(?!「)[^」]*」|(\"++)(?:(?!\\8).)+\\8|「++|\"++)|[^)）])*+)?([）)])?)?(?:[\\s　]*([＃#].*))?",
            "captures": {
                "2": {
                    "name": "keyword.other.marker.pasta"
                },
                "3": {
                    "name": "entity.name.function.cue.pasta"
                },
                "4": {
                    "name": "punctuation.separator.pasta"
                },
                "5": {
                    "name": "variable.other.reference.pasta"
                },
                "6": {
                    "name": "punctuation.bracket.begin.pasta"
                },
                "7": {
                    "patterns": [
                        {
                            "include": "#cue-arg-string"
                        },
                        {
                            "include": "#cue-arg-number"
                        },
                        {
                            "include": "#cue-arg-at-ref"
                        },
                        {
                            "include": "#cue-arg-ident"
                        }
                    ]
                },
                "9": {
                    "name": "punctuation.bracket.end.pasta"
                },
                "10": {
                    "name": "comment.line.pasta"
                }
            },
            "name": "meta.cue-command.pasta"
        },
        "cue-arg-string": {
            "match": "「{4}(?:(?!」{4}).)+」{4}|「{3}(?!「)(?:(?!」{3}).)+」{3}|「{2}(?!「)(?:(?!」{2}).)+」{2}|「(?!「)[^」]*」|(\"++)(?:(?!\\1).)+\\1|\"\"",
            "name": "string.quoted.other.pasta"
        },
        "cue-arg-number": {
            "match": "[0-9０-９]+(?:[.．][0-9０-９]+)?",
            "name": "constant.numeric.pasta"
        },
        "cue-arg-at-ref": {
            "match": "[＠@][^,、)）\\s\u3000]+",
            "name": "variable.other.reference.pasta"
        },
        "cue-arg-ident": {
            "match": "[^,、)）\\s\u3000]+",
            "name": "entity.name.tag.pasta"
        }
    }
}