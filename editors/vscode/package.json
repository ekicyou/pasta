{
    "name": "pasta-vscode",
    "displayName": "Pasta DSL",
    "description": "Syntax highlighting and diagnostics for Pasta DSL (*.pasta) files",
    "version": "0.5.2",
    "publisher": "ekicyou",
    "license": "MIT",
    "icon": "img/pasta.png",
    "keywords": [
        "pasta",
        "dsl",
        "ukagaka",
        "ghost",
        "scripting"
    ],
    "homepage": "https://github.com/ekicyou/pasta",
    "bugs": {
        "url": "https://github.com/ekicyou/pasta/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ekicyou/pasta"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:pasta"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "pasta.runSceneAtCursor",
                "title": "▶ シーンを実行",
                "category": "Pasta",
                "icon": "$(play)"
            },
            {
                "command": "pasta.reloadShiori",
                "title": "SHIORI をリロード",
                "category": "Pasta",
                "icon": "$(refresh)"
            },
            {
                "command": "pasta.showSaveVariables",
                "title": "保存変数を表示",
                "category": "Pasta"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "pasta.runSceneAtCursor",
                    "group": "navigation@1",
                    "when": "resourceLangId == pasta"
                },
                {
                    "command": "pasta.reloadShiori",
                    "group": "navigation@2",
                    "when": "resourceLangId == pasta || resourceLangId == lua || resourceFilename =~ /^pasta\\.toml$/i"
                },
                {
                    "command": "pasta.showSaveVariables",
                    "group": "navigation@3",
                    "when": "resourceLangId == pasta || resourceLangId == lua || resourceFilename =~ /^pasta\\.toml$/i"
                }
            ]
        },
        "languages": [
            {
                "id": "pasta",
                "aliases": [
                    "Pasta DSL",
                    "pasta"
                ],
                "extensions": [
                    ".pasta"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "pasta",
                "scopeName": "source.pasta",
                "path": "./syntaxes/pasta.tmLanguage.json"
            },
            {
                "scopeName": "pasta-lua.injection",
                "path": "./syntaxes/pasta-lua-injection.tmLanguage.json",
                "injectTo": [
                    "source.pasta"
                ]
            }
        ],
        "semanticTokenTypes": [
            {
                "id": "scene",
                "superType": "type",
                "description": "Local scene marker"
            },
            {
                "id": "word",
                "superType": "function",
                "description": "Word definition/reference"
            },
            {
                "id": "call",
                "superType": "keyword",
                "description": "Call/Jump statement"
            },
            {
                "id": "actor",
                "superType": "class",
                "description": "Actor dictionary marker"
            },
            {
                "id": "actorName",
                "superType": "type",
                "description": "Actor name before colon"
            },
            {
                "id": "talk",
                "description": "Talk text (dialogue)"
            },
            {
                "id": "codeBlock",
                "superType": "string",
                "description": "Lua code block"
            },
            {
                "id": "sakuraScript",
                "superType": "string",
                "description": "Sakura Script tag"
            },
            {
                "id": "escape",
                "superType": "string",
                "description": "Escape sequence"
            },
            {
                "id": "number",
                "superType": "number",
                "description": "Numeric literal"
            },
            {
                "id": "cueMarker",
                "superType": "keyword",
                "description": "Cue command marker (! / ！)"
            },
            {
                "id": "cueCommand",
                "superType": "function",
                "description": "Cue command name"
            }
        ],
        "semanticTokenModifiers": [
            {
                "id": "global",
                "description": "Global scope modifier"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "pasta",
                "scopes": {
                    "comment": [
                        "comment.line.pasta"
                    ],
                    "namespace": [
                        "keyword.control.scene.pasta"
                    ],
                    "scene": [
                        "keyword.control.scene.pasta"
                    ],
                    "decorator": [
                        "entity.other.attribute-name.pasta"
                    ],
                    "word": [
                        "string.key.word.pasta"
                    ],
                    "variable": [
                        "variable.other.pasta"
                    ],
                    "call": [
                        "keyword.control.pasta"
                    ],
                    "actor": [
                        "entity.name.class.pasta"
                    ],
                    "actorName": [
                        "entity.name.type.actor.pasta"
                    ],
                    "codeBlock": [
                        "meta.embedded.block.lua"
                    ],
                    "talk": [
                        "meta.talk.pasta"
                    ],
                    "sakuraScript": [
                        "string.other.sakura-script.pasta"
                    ],
                    "escape": [
                        "constant.character.escape.pasta"
                    ],
                    "operator": [
                        "punctuation.separator.pasta"
                    ],
                    "number": [
                        "constant.numeric.pasta"
                    ],
                    "cueMarker": [
                        "keyword.other.marker.pasta"
                    ],
                    "cueCommand": [
                        "entity.name.function.cue.pasta"
                    ]
                }
            }
        ]
    },
    "scripts": {
        "compile": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
        "watch": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
        "lint": "eslint src",
        "test:grammar": "esbuild ./src/test/tmGrammar.test.ts --bundle --outfile=out/test/tmGrammar.test.js --format=cjs --platform=node --sourcemap --alias:vscode=./src/test/mock/vscode.ts && node out/test/tmGrammar.test.js",
        "test:unit": "esbuild ./src/test/mcpClient.test.ts --bundle --outfile=out/test/mcpClient.test.js --format=cjs --platform=node --sourcemap && esbuild ./src/test/ghostFiles.test.ts --bundle --outfile=out/test/ghostFiles.test.js --format=cjs --platform=node --sourcemap && esbuild ./src/test/dumpVariables.test.ts --bundle --outfile=out/test/dumpVariables.test.js --format=cjs --platform=node --sourcemap && esbuild ./src/test/fakeMcpServer.selfcheck.ts --bundle --outfile=out/test/fakeMcpServer.selfcheck.js --format=cjs --platform=node --sourcemap && esbuild ./src/test/runSceneAtCursor.test.ts --bundle --outfile=out/test/runSceneAtCursor.test.js --format=cjs --platform=node --sourcemap && esbuild ./src/test/reloadShiori.test.ts --bundle --outfile=out/test/reloadShiori.test.js --format=cjs --platform=node --sourcemap && esbuild ./src/test/vscodeModules.test.ts --bundle --outfile=out/test/vscodeModules.test.js --format=cjs --platform=node --sourcemap --alias:vscode=./src/test/mock/vscode.ts && esbuild ./src/test/ghostValidator.test.ts --bundle --outfile=out/test/ghostValidator.test.js --format=cjs --platform=node --sourcemap --alias:vscode=./src/test/mock/vscode.ts && esbuild ./src/test/contributions.test.ts --bundle --outfile=out/test/contributions.test.js --format=cjs --platform=node --sourcemap && node out/test/runSceneAtCursor.test.js && node out/test/reloadShiori.test.js && node out/test/mcpClient.test.js && node out/test/ghostFiles.test.js && node out/test/dumpVariables.test.js && node out/test/fakeMcpServer.selfcheck.js && node out/test/contributions.test.js && node out/test/vscodeModules.test.js && node out/test/ghostValidator.test.js",
        "test:e2e": "esbuild ./src/test/e2e.test.ts --bundle --outfile=out/test/e2e.test.js --format=cjs --platform=node --sourcemap && esbuild ./src/test/devCommands.e2e.test.ts --bundle --outfile=out/test/devCommands.e2e.test.js --format=cjs --platform=node --sourcemap --alias:vscode=./src/test/mock/vscode.ts && node out/test/e2e.test.js && node out/test/devCommands.e2e.test.js",
        "test": "npm run test:grammar && npm run test:unit && npm run test:e2e",
        "prepackage": "npm run build:wasm && npm run compile",
        "package": "vsce package",
        "build:wasm": "pwsh -NoProfile -File scripts/build-wasm.ps1 -Release"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.85.0",
        "@vscode/vsce": "^4.1.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.4.1",
        "typescript": "^5.5.0",
        "typescript-eslint": "^8.61.0",
        "vscode-oniguruma": "^2.0.0",
        "vscode-textmate": "^9.0.0"
    }
}
