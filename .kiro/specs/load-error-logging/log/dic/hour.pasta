＃ hour.pasta - 時報トーク（emo2-talk-port）
＃ emo-gs dic/talks/cal.lua の 24 時間 10 パターンを忠実移植
＃ OnHour は仮想イベント。複数定義するとランダム選択されるため、1 シーンのみ定義し Lua で分岐

＊OnHour
```lua
function SCENE.on_hour(act)
    local save, var = act:init_scene(SCENE)
    local h = var.hour
    if h == nil then return nil end
    h = tonumber(h)
    if h == nil then return nil end

    local s = ""

    if h == 0 then
        -- 深夜0時
        s = "\\1\\s[通常]深夜0時になったよ。"
            .. "\\n\\0\\s[3]新しい日‥‥はええから、寝よ寝よ。"
    elseif h >= 1 and h <= 3 then
        -- 深夜
        s = "\\0\\s[6]"
            .. "\\1\\s[通常]午前" .. h .. "時になったよ。"
            .. "\\n\\0\\s[6]（‥‥ぐぅ）"
    elseif h >= 4 and h <= 5 then
        -- 早朝
        s = "\\0\\s[0]"
            .. "\\1\\s[通常]午前" .. h .. "時になったよ。"
            .. "\\n\\0\\s[4]うぅ、起こさんといて、二度寝‥‥。"
    elseif h >= 6 and h <= 8 then
        -- 朝
        s = "\\0\\s[0]"
            .. "\\1\\s[通常]午前" .. h .. "時になったよ。"
            .. "\\n\\0\\s[5]おはよー！パンを咥えて、\\n気になるあの子にぶつかるでー。"
    elseif h >= 9 and h <= 11 then
        -- 午前
        s = "\\0\\s[0]"
            .. "\\1\\s[通常]午前" .. h .. "時になったよ。"
            .. "\\n\\0\\s[4]うち、まだ眠いわ‥‥。"
    elseif h == 12 then
        -- 正午
        s = "\\0\\s[0]"
            .. "\\1\\s[通常]正午だよ。"
            .. "\\n\\0\\s[5]おっひるはなにかいなー♪"
    elseif h >= 13 and h <= 16 then
        -- 午後
        s = "\\0\\s[0]"
            .. "\\1\\s[通常]午後" .. (h - 12) .. "時になったよ。"
            .. "\\n\\0\\s[5]午後もがんばろー！"
    elseif h >= 17 and h <= 18 then
        -- 夕方
        s = "\\0\\s[0]"
            .. "\\1\\s[通常]午後" .. (h - 12) .. "時になったよ。"
            .. "\\n\\0\\s[0]そろそろ夕方やね。"
    elseif h >= 19 and h <= 20 then
        -- 晩御飯
        s = "\\0\\s[0]"
            .. "\\1\\s[通常]午後" .. (h - 12) .. "時になったよ。"
            .. "\\n\\0\\s[5]お夕飯はなにかいなー♪"
    elseif h >= 21 then
        -- 夜
        s = "\\0\\s[0]"
            .. "\\1\\s[通常]午後" .. (h - 12) .. "時になったよ。"
            .. "\\n\\0\\s[8]夜更かしはほどほどにして、\\n寝なあかんよ。"
    end

    if s == "" then return nil end
    return s
end
```
　＠on_hour()
