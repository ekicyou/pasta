{{!--
  ============================================================================
  pasta-user-manual タスク 3.2: 検索クエリの bigram override
  （Requirements 2.1, 2.3, 2.4, 2.5 / design.md「Bigram Search」）

  目的:
    索引側（3.1 build-index.mjs）は本文を 2-gram で再生成し、検索時に
    elasticlunr が用いる pipeline を reset 済みにしている。検索の整合には
    「クエリ側も索引と同一規則（2-gram）で分割」する必要がある（不一致は検索破綻）。

  実装方式（v0.5.3 の制約に基づく選択）:
    当初設計は `theme/searcher.js` を置いて mdBook 既定 searcher を差し替える前提
    だったが、mdBook v0.5.3 は検索ランタイム（searcher-<hash>.js）をテーマ
    オーバーライド対象に含めず、`theme/searcher.js` を置いても無視して既定を出力する
    （空テーマで実測確認済み）。一方 `theme/head.hbs` は全ページ <head> に確実に
    取り込まれる正規のオーバーライド対象である。

    そこで本ファイルは、elasticlunr が読み込まれる前（<head> 段階）に
    `window.elasticlunr` へアクセサ（defineProperty）を仕掛け、elasticlunr の UMD が
    グローバルへ自身を代入した瞬間に `elasticlunr.tokenizer` を 2-gram tokenize へ
    差し替える。elasticlunr の `Index.search` はクエリを
    `pipeline.run(elasticlunr.tokenizer(query))` で分割するため、これで索引・クエリの
    規則が一致し、語中2文字（連続2文字以上の日本語）がその語を含むページにヒットする。
    既定 searcher は無改変・サーバ通信なしのまま動作する。

  規則の単一ソース性（design Invariant）:
    下記 tokenize は `book/tools/bigram-index/tokenize.mjs`（正準・単一ソース）と
    「同一規則」でなければならない。ブラウザは ESM import 不可ゆえ同ロジックを
    インライン同梱している。tokenize.mjs を変更した場合は本ファイルの該当ブロックも
    必ず同期すること（関数本体は tokenize.mjs から `export` を除いた逐語コピー）。
  ============================================================================
--}}
{{!-- manual-claudia-theme タスク 2.5（要件 1.3・1.6・8.5、design「FontLoader」）:
  Claudia テーマの Web フォントを Google Fonts から読む（公開物に同梱しない。マニュアル唯一の外部通信で任意）。
  字体トークン（claudia.css の --claudia-font-*）が使う 4 書体の、CSS が使う太さだけを読む。
  display=swap と claudia.css のフォールバック列で、読み込めないとき（オフライン等）もシステム字体で読める。
  mdBook の CSS より前に展開されるので、additional-css の @import より早く取得が始まる。
  下の tokenizer・neutralizer のブロックとは独立（BEGIN/END マーカーの外に置く）。 --}}
{{!-- SNS に URL を貼ったときのカード（OGP）。画像は全ページ共通の 1 枚で、元は book/tools/ogp/ogp.html。
  og:image は絶対 URL でないと SNS が読まないので、公開先（GitHub Pages）の URL を直に書く。
  meta は通信しないので、verify-static の外部参照の検査（link・script・img）には掛からない。 --}}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ book_title }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="https://ekicyou.github.io/pasta/img/ogp.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&family=BIZ+UDPMincho:wght@400;700&family=Cormorant+Garamond:ital,wght@1,500&family=Shippori+Mincho+B1:wght@600;800&display=swap">
<script>
(function () {
    'use strict';

    // --- BEGIN canonical bigram tokenize (mirror of book/tools/bigram-index/tokenize.mjs) ---
    // 正規化: 小文字化 + 全角英数を半角へ（NFKC は CJK 互換まで畳むため使わず、英数記号のみ畳む）。
    function normalize(text) {
        return text
            .toLowerCase()
            // 全角英数字 → 半角
            .replace(/[Ａ-Ｚａ-ｚ０-９]/g, function (c) {
                return String.fromCharCode(c.charCodeAt(0) - 0xfee0);
            });
    }

    // 1 文字が「CJK 等の語中連結対象（bigram 化する文字）」かどうか。
    function isCjk(ch) {
        var cp = ch.codePointAt(0);
        return (
            (cp >= 0x3040 && cp <= 0x30ff) || // ひらがな・カタカナ
            (cp >= 0x3400 && cp <= 0x4dbf) || // CJK 拡張A
            (cp >= 0x4e00 && cp <= 0x9fff) || // CJK 統合漢字
            (cp >= 0xf900 && cp <= 0xfaff) || // CJK 互換漢字
            (cp >= 0xff66 && cp <= 0xff9f) || // 半角カタカナ
            cp === 0x30fc || // 長音記号 ー
            (cp >= 0x20000 && cp <= 0x2ffff) // CJK 拡張B以降
        );
    }

    // 入力文字列をトークン列へ（連続 CJK は隣接 2-gram、ASCII は空白・ハイフン区切り）。
    function tokenize(input) {
        if (input === null || input === undefined) {
            return [];
        }
        var text = normalize(String(input));
        var tokens = [];

        var i = 0;
        var n = text.length;
        while (i < n) {
            var ch = text[i];
            if (isCjk(ch)) {
                // CJK ランを収集
                var j = i;
                var run = [];
                while (j < n && isCjk(text[j])) {
                    run.push(text[j]);
                    j++;
                }
                if (run.length === 1) {
                    tokens.push(run[0]);
                } else {
                    for (var k = 0; k + 1 < run.length; k++) {
                        tokens.push(run[k] + run[k + 1]);
                    }
                }
                i = j;
            } else if (/\s/.test(ch) || ch === '-') {
                i++;
            } else {
                // 非 CJK・非区切り（ASCII 英数記号など）のラン
                var j2 = i;
                var run2 = [];
                while (j2 < n && !isCjk(text[j2]) && !/\s/.test(text[j2]) && text[j2] !== '-') {
                    run2.push(text[j2]);
                    j2++;
                }
                tokens.push(run2.join(''));
                i = j2;
            }
        }
        return tokens.filter(function (t) { return t.length > 0; });
    }
    // --- END canonical bigram tokenize ---

    // クエリ側 tokenizer を bigram tokenize へ差し替える。
    function applyBigramTokenizer(el) {
        if (el && typeof el === 'function' && el.tokenizer !== tokenize) {
            el.tokenizer = tokenize;
        }
    }

    // elasticlunr-<hash>.min.js は <head> 後（body 末尾）で読み込まれ、UMD が
    // `window.elasticlunr = factory()` を実行する。そのタイミングを捕捉して
    // tokenizer を確実に差し替えるため、代入を監視するアクセサを先に仕込む。
    if (Object.prototype.hasOwnProperty.call(window, 'elasticlunr') && window.elasticlunr) {
        // 既に読み込まれていれば即適用（読み込み順が変わっても安全側に倒す）。
        applyBigramTokenizer(window.elasticlunr);
    } else {
        try {
            var holder;
            Object.defineProperty(window, 'elasticlunr', {
                configurable: true,
                enumerable: true,
                get: function () { return holder; },
                set: function (v) {
                    holder = v;
                    applyBigramTokenizer(v);
                },
            });
        } catch (e) {
            // defineProperty 不可な環境ではポーリングでフォールバック。
            var tries = 0;
            var timer = setInterval(function () {
                if (window.elasticlunr || tries++ > 200) {
                    clearInterval(timer);
                    applyBigramTokenizer(window.elasticlunr);
                }
            }, 25);
        }
    }
})();
</script>
{{!--
  ============================================================================
  pasta-manual-syntax-highlight タスク 4.1: book.js 再ハイライトの中和
  （Requirements 3.1, 3.2, 4.2 / design.md「ClientNeutralizer (theme/head.hbs)」）

  目的:
    mdBook の `book.js`（`codeSnippets()` 即時 IIFE）は全 `<code>`（ヘッダ除く）に
    `hljs.highlightBlock(block)` を無条件適用し、未登録言語 `pasta` を plaintext として
    innerHTML を再生成するため、build-time に焼き込んだ事前 span を破壊する（research §8.3）。

  実装方式（既存 elasticlunr アクセサと同型・research §8.3 で確定）:
    elasticlunr が読み込まれる前と同様、highlight-*.js が `window.hljs` を代入する前の
    <head> 段階で `Object.defineProperty(window,'hljs',…)` のアクセサを仕込む。代入の
    瞬間に `highlightBlock`（旧名）と `highlightElement`（新名）の両方をラップし、引数要素が
    `language-pasta` クラスを持つ場合は原処理を呼ばずスキップして事前 span を保持する（3.1）。
    それ以外のブロックは原処理へそのまま委譲し、既存ハイライト挙動を変えない（3.2）。
    head.hbs は <head>（最早）で走り、hljs バンドル・book.js はそれ以降に読まれるため
    発火順序が保証される（elasticlunr で実証済み）。ネットワーク・サーバ非依存ゆえ
    `file://` オフライン閲覧でも同様に動作する（4.2）。

  規則の単一ソース性（design Invariant）:
    下記中和ロジックは `book/tools/highlight/neutralizer.mjs`（正準・単一ソース）の
    `installHljsNeutralizer` 関数本体と「同一ロジック」でなければならない。ブラウザは
    ESM import 不可ゆえ同ロジックをインライン同梱している（関数本体を `export` を除いた
    逐語コピーし、引数 win を window へ束ねて即時実行）。neutralizer.mjs を変更した場合は
    本ファイルの該当ブロックも必ず同期すること。既存 elasticlunr ブロックとは独立共存する。
  ============================================================================
--}}
<script>
(function () {
    'use strict';

    // --- BEGIN canonical hljs neutralizer (mirror of book/tools/highlight/neutralizer.mjs) ---
    // installHljsNeutralizer(win) の関数本体を export 抜きで逐語コピー。win は window 固定。
    var win = window;
    if (!win) {
        return;
    }

    // 引数要素が language-pasta クラスを持つか判定（3.1 のスキップ条件）。
    // classList.contains を優先し、無い環境向けに className 文字列 fallback も用意。
    function isPastaElement(el) {
        if (!el) {
            return false;
        }
        if (el.classList && typeof el.classList.contains === 'function') {
            return el.classList.contains('language-pasta');
        }
        var cls = el.className;
        if (typeof cls === 'string') {
            return (' ' + cls + ' ').indexOf(' language-pasta ') !== -1;
        }
        return false;
    }

    // 原処理を language-pasta スキップ付きでラップする。二重ラップは避ける（冪等）。
    function wrap(fn) {
        if (typeof fn !== 'function' || fn.__pastaNeutralized) {
            return fn;
        }
        var wrapped = function (el) {
            // language-pasta は原処理を呼ばずスキップ（事前 span を破壊しない・3.1）。
            if (isPastaElement(el)) {
                return undefined;
            }
            // それ以外は原処理へそのまま委譲し戻り値も返す（既存挙動不変・3.2）。
            return fn.apply(this, arguments);
        };
        wrapped.__pastaNeutralized = true;
        return wrapped;
    }

    // hljs オブジェクトの highlightBlock / highlightElement を両方ラップする。
    // 既にラップ済みなら何もしない（冪等・二重 wrap 防止）。
    function neutralize(hljs) {
        if (!hljs || hljs.__pastaNeutralized) {
            return;
        }
        if (typeof hljs.highlightBlock === 'function') {
            hljs.highlightBlock = wrap(hljs.highlightBlock);
        }
        if (typeof hljs.highlightElement === 'function') {
            hljs.highlightElement = wrap(hljs.highlightElement);
        }
        try {
            hljs.__pastaNeutralized = true;
        } catch (e) {
            // 凍結オブジェクト等でマーカーを置けなくてもラップ自体は済んでいる。
        }
    }

    // highlight-*.js は <head> 後（body 末尾）で読み込まれ `window.hljs = …` を実行する。
    // そのタイミングを捕捉して確実にラップするため、代入を監視するアクセサを先に仕込む。
    if (Object.prototype.hasOwnProperty.call(win, 'hljs') && win.hljs) {
        // 既に読み込まれていれば即ラップ（読み込み順が変わっても安全側に倒す）。
        neutralize(win.hljs);
    } else {
        try {
            var holder;
            Object.defineProperty(win, 'hljs', {
                configurable: true,
                enumerable: true,
                get: function () {
                    return holder;
                },
                set: function (v) {
                    holder = v;
                    neutralize(v);
                },
            });
        } catch (e) {
            // defineProperty 不可な環境ではポーリングでフォールバック。
            var tries = 0;
            var timer = setInterval(function () {
                if (win.hljs || tries++ > 200) {
                    clearInterval(timer);
                    neutralize(win.hljs);
                }
            }, 25);
        }
    }
    // --- END canonical hljs neutralizer ---
})();
</script>
{{!-- 目次を描く前に開き直す（getting-started-screenshots の完了時の棚卸。2026-10-17 に実ブラウザーで見つかった、目次の持ち越しのちらつきの修正）。
  mdBook 0.5.x は、本文の頭の埋め込みスクリプトで、幅 1080px 未満では保存値を見ずに目次を閉じる。
  claudia.js の claudiaSidebarKeep は本文の最後で開き直すので、その間に閉じた画面が一度描かれ、本文の幅が変わってちらつく。
  ここでは <head> で html のクラスの変化を見張り、埋め込みが目次を閉じた直後（パーサーが続きを読む前・描く前）に、
  claudiaSidebarKeep と同じ条件（幅 620px 以上 1080px 未満・保存値が visible）で開いた状態へ戻す。
  続く埋め込みが ARIA 属性とリンクの tabIndex をそろえるよう、埋め込みの変数 sidebar も visible にする。
  目次がもうある（知らせが遅れて届いた）ときは、ARIA 属性・tabIndex・display をここでそろえる。
  開くときのアニメーションは出さない（sidebar-resizing を付けて開き、描いた後に外す）。保存値は書かない。
  claudiaSidebarKeep は、チェックボックスが入っていれば何もしないので、そのまま残す（MutationObserver が無いときの受け皿）。
  検査: book/tools/theme-sidebar-early-test.mjs（jsdom）。 --}}
<script>
(function claudiaSidebarEarly() {
    'use strict';

    if (typeof MutationObserver !== 'function') {
        return;
    }
    var html = document.documentElement;
    var observer = new MutationObserver(function () {
        var checkbox = document.getElementById('mdbook-sidebar-toggle-anchor');
        if (!checkbox) {
            return; // まだ目次を閉じる埋め込みより前（テーマの埋め込みがクラスを替えた）
        }
        observer.disconnect();
        if (checkbox.checked || html.classList.contains('sidebar-visible')) {
            return;
        }
        var width = document.body ? document.body.clientWidth : 0;
        if (width < 620 || width >= 1080) {
            return;
        }
        var stored;
        try {
            stored = localStorage.getItem('mdbook-sidebar');
        } catch (e) {
            return;
        }
        if (stored !== 'visible') {
            return;
        }
        html.classList.add('sidebar-resizing');
        html.classList.add('sidebar-visible');
        checkbox.checked = true;
        try {
            sidebar = 'visible'; // mdBook の埋め込みの let sidebar（続く埋め込みが ARIA 属性をこれでそろえる）
        } catch (e) {
            // 埋め込みの形が変わっていても、下で目次がもうあればそろえる
        }
        var nav = document.getElementById('mdbook-sidebar');
        if (nav) {
            nav.style.display = '';
            nav.setAttribute('aria-hidden', 'false');
            Array.from(nav.querySelectorAll('a')).forEach(function (link) {
                link.setAttribute('tabIndex', 0);
            });
            var toggle = document.getElementById('mdbook-sidebar-toggle');
            if (toggle) {
                toggle.setAttribute('aria-expanded', 'true');
            }
        }
        requestAnimationFrame(function () {
            requestAnimationFrame(function () {
                html.classList.remove('sidebar-resizing');
            });
        });
    });
    observer.observe(html, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('DOMContentLoaded', function () {
        observer.disconnect();
    });
})();
</script>
